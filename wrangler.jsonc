{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-03-17",
  "preview_urls": true,
  "workers_dev": true,
  "previews": {},
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "chensl.me",
      "custom_domain": true,
    },
  ],
}
