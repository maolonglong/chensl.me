{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "workers_dev": true,
  "previews": {
    "d1_databases": [
      {
        "binding": "VOTES",
        "database_name": "blog-votes-preview",
        "database_id": "9d595256-8798-415b-afe9-36d2c5ef18fb",
        "migrations_dir": "migrations",
      },
      {
        "binding": "NEWS",
        "database_name": "blog-news-preview",
        // Placeholder: replace with the ID that `wrangler d1 create blog-news-preview` prints.
        "database_id": "51c7df6e-e404-439f-a690-c26452f57e2d",
        "migrations_dir": "migrations/news",
      },
    ],
    // Same limits as production. Separate namespace IDs keep Preview traffic out of the
    // production counters.
    "ratelimits": [
      {
        "name": "VOTE_LIMITER",
        "namespace_id": "2001",
        "simple": { "limit": 30, "period": 60 },
      },
      {
        "name": "READ_LIMITER",
        "namespace_id": "2002",
        "simple": { "limit": 120, "period": 60 },
      },
    ],
    // Search: query embeddings and the AI News index write call Workers AI. Previews use their
    // own index, so Preview news writes never reach the production vectors.
    "ai": { "binding": "AI" },
    "vectorize": [{ "binding": "SEARCH_INDEX", "index_name": "blog-search-preview" }],
  },
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // An array makes routing explicit: only these paths reach the Worker, and every other path
    // that is not a file gets the 404 page, so each new Worker route must be listed here.
    "run_worker_first": ["/_actions/*", "/api/*", "/news/*"],
  },
  "d1_databases": [
    {
      "binding": "VOTES",
      "database_name": "blog-votes",
      "database_id": "9bb848f2-e206-40b1-b209-28cba4bffc1f",
      "preview_database_id": "9d595256-8798-415b-afe9-36d2c5ef18fb",
      "migrations_dir": "migrations",
    },
    {
      "binding": "NEWS",
      "database_name": "blog-news",
      // Placeholder: replace with the ID that `wrangler d1 create blog-news` prints.
      "database_id": "9044b4b0-25f7-47cd-aa59-ebad8c64e502",
      "preview_database_id": "51c7df6e-e404-439f-a690-c26452f57e2d",
      "migrations_dir": "migrations/news",
    },
  ],
  // The bot that writes /api/news/ authenticates with this token.
  "secrets": {
    "required": ["NEWS_TOKEN"],
  },
  // Caches the on-demand /news/ and /api/search/ responses for their s-maxage; Actions are POST
  // and private.
  "cache": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "VOTE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  // Search: Workers AI embeds queries and AI News items; blog-search holds the article chunks and
  // news items (.github/workflows/search-index.yml writes the articles).
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "SEARCH_INDEX", "index_name": "blog-search" }],
  "routes": [
    {
      "pattern": "chensl.me",
      "custom_domain": true,
    },
  ],
}
