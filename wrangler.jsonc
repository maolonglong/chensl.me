{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "workers_dev": true,
  "previews": {
    "d1_databases": [
      {
        "binding": "VOTES",
        "database_name": "blog-votes-preview",
        "database_id": "9d595256-8798-415b-afe9-36d2c5ef18fb",
        "migrations_dir": "migrations",
      },
      {
        "binding": "NEWS",
        "database_name": "blog-news-preview",
        // Placeholder: replace with the ID that `wrangler d1 create blog-news-preview` prints.
        "database_id": "00000000-0000-0000-0000-00000000000b",
        "migrations_dir": "migrations/news",
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // An array makes routing explicit: only these paths reach the Worker, and every other path
    // that is not a file gets the 404 page, so each new Worker route must be listed here.
    "run_worker_first": ["/_actions/*", "/api/*", "/news/*"],
  },
  "d1_databases": [
    {
      "binding": "VOTES",
      "database_name": "blog-votes",
      "database_id": "9bb848f2-e206-40b1-b209-28cba4bffc1f",
      "preview_database_id": "9d595256-8798-415b-afe9-36d2c5ef18fb",
      "migrations_dir": "migrations",
    },
    {
      "binding": "NEWS",
      "database_name": "blog-news",
      // Placeholder: replace with the ID that `wrangler d1 create blog-news` prints.
      "database_id": "00000000-0000-0000-0000-00000000000a",
      "preview_database_id": "00000000-0000-0000-0000-00000000000b",
      "migrations_dir": "migrations/news",
    },
  ],
  // The bot that writes /api/news/ authenticates with this token.
  "secrets": {
    "required": ["NEWS_TOKEN"],
  },
  // Caches the on-demand /news/ responses for their s-maxage; Actions are POST and private.
  "cache": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "VOTE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "routes": [
    {
      "pattern": "chensl.me",
      "custom_domain": true,
    },
  ],
}
