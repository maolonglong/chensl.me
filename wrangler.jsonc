{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-03-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "chensl.me",
      "custom_domain": true
    }
  ],
  "preview_urls": true,
  "workers_dev": true,
  "build": {
    "command": "chmod a+x build.sh && ./build.sh"
  }
}
