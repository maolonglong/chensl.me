{{- /* Every feed carries blog posts only, newest first, with full content. */ -}}
{{- $pages := where site.RegularPages "Section" "blog" -}}
{{- if .IsSection }}{{ $pages = .RegularPages }}{{ end -}}
{{- with site.Config.Services.RSS.Limit }}{{ if ge . 1 }}{{ $pages = first . $pages }}{{ end }}{{ end -}}
{{- $author := printf "%s (%s)" site.Params.author.email site.Params.author.name -}}
{{- $rfc822 := "Mon, 02 Jan 2006 15:04:05 -0700" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    <managingEditor>{{ $author }}</managingEditor>
    <webMaster>{{ $author }}</webMaster>
    {{- with $pages }}
    <lastBuildDate>{{ (index .ByLastmod.Reverse 0).Lastmod.Format $rfc822 }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format $rfc822 }}</pubDate>
      <author>{{ $author }}</author>
      <guid>{{ .Permalink }}</guid>
      <description>{{ or .Description .Summary | transform.XMLEscape | safeHTML }}</description>
      <content:encoded>{{ .Content | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
