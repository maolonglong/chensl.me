---
export interface Props {
  tags: string[]
}
const { tags } = Astro.props
---

<ul class="tags" aria-label="涉及">
  {tags.map((tag) => (
    <li class="tag">{tag}</li>
  ))}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    padding: 1px 7px;
    font-size: var(--size-caption);
    line-height: 1.5;
    color: var(--muted-color);
    background-color: var(--surface-color);
    border-radius: 4px;
  }
</style>
