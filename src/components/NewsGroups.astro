---
import { groupByTag, isWebUrl, type NewsItem } from '../lib/news'

export interface Props {
  items: NewsItem[]
  level: 2 | 3
}
const { items, level } = Astro.props
const Group = `h${level}` as 'h2' | 'h3'
const Item = `h${level + 1}` as 'h3' | 'h4'
---

{groupByTag(items).map((group) => (
  <section class="group">
    <Group class="group-tag section-label">{group.tag}</Group>
    <ul class="items">
      {group.items.map((item) => (
        <li>
          <Item class="item-title">
            {isWebUrl(item.url) ? (
              <a class="external" href={item.url} rel="noopener noreferrer">
                {item.title}
              </a>
            ) : (
              item.title
            )}
          </Item>
          <p class="item-summary">{item.summary}</p>
        </li>
      ))}
    </ul>
  </section>
))}

<style>
  .group {
    margin-top: var(--space-7);
  }
  .group-tag {
    margin-bottom: var(--space-4);
    letter-spacing: 0.04em;
  }
  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .items > li + li {
    margin-top: var(--space-5);
  }
  .item-title {
    margin: 0;
    font-size: var(--size-body);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--heading-color);
  }
  .item-title a {
    color: inherit;
  }
  /* Every item leaves the site, so the title carries the same arrow as an external prose link. */
  .external::after {
    content: '↗\FE0E' / '';
    display: inline-block;
    margin-left: 0.2em;
    font-size: 0.75em;
    color: var(--muted-color);
    transition: transform 150ms var(--ease-out);
  }
  @media (hover: hover) {
    .item-title a:hover {
      color: inherit;
      text-decoration-color: var(--rule-color);
    }
    .external:hover::after {
      transform: translate(1px, -1px);
    }
  }
  .item-summary {
    margin: var(--space-1) 0 0;
    color: var(--text-color);
  }
</style>
