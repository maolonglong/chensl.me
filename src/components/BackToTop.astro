<template id="back-to-top-template">
  <button class="back-to-top" type="button" aria-label="回到顶部">
    <svg
      class="back-to-top-icon"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M7 5h10M12 19V9m-5 5 5-5 5 5" />
    </svg>
  </button>
</template>
<script>
  ;(() => {
    const template = document.querySelector<HTMLTemplateElement>('#back-to-top-template')
    if (!template) return
    const button = template.content.firstElementChild!.cloneNode(true) as HTMLButtonElement
    document.body.append(button)
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const toggle = () => button.toggleAttribute('data-visible', window.scrollY > window.innerHeight)
    window.addEventListener('scroll', toggle, { passive: true })
    window.addEventListener('resize', toggle)
    toggle()
    button.addEventListener('click', (event) => {
      if (reduceMotion.matches) window.scrollTo({ top: 0, behavior: 'instant' })
      else {
        if (window.scrollY > window.innerHeight)
          window.scrollTo({ top: window.innerHeight, behavior: 'instant' })
        window.scrollTo({ top: 0, behavior: 'smooth' })
      }
      if (event.detail === 0)
        document.querySelector<HTMLAnchorElement>('.site-title a')?.focus({ preventScroll: true })
    })
  })()
</script>
