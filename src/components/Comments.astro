---
import { giscusThemes } from '../lib/assets'
---

<section
  class="comments"
  aria-labelledby="comments-title"
  data-light-theme={giscusThemes.light}
  data-dark-theme={giscusThemes.dark}
>
  <h2 class="section-label" id="comments-title">
    评论
  </h2>
  <div class="giscus"></div>
  <noscript>
    <p class="comments-unavailable">启用 JavaScript 后可以查看和发表评论。</p>
  </noscript>
</section>
<script>
  ;(() => {
    const section = document.querySelector<HTMLElement>('.comments')
    if (!section) return
    const themes = {
      light: new URL(section.dataset.lightTheme!, window.location.origin).href,
      dark: new URL(section.dataset.darkTheme!, window.location.origin).href,
    }
    const resolvedTheme = (): 'light' | 'dark' => {
      const { theme } = document.documentElement.dataset
      if (theme === 'light' || theme === 'dark') return theme
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    const script = document.createElement('script')
    script.src = 'https://giscus.app/client.js'
    script.async = true
    script.crossOrigin = 'anonymous'
    Object.assign(script.dataset, {
      repo: 'maolonglong/chensl.me',
      repoId: 'MDEwOlJlcG9zaXRvcnk0MDY3MzAwMDI=',
      category: 'Announcements',
      categoryId: 'DIC_kwDOGD41Es4ClVVI',
      mapping: 'pathname',
      strict: '1',
      reactionsEnabled: '1',
      emitMetadata: '0',
      inputPosition: 'top',
      theme: themes[resolvedTheme()],
      lang: 'zh-CN',
      loading: 'lazy',
    })
    const syncTheme = (themeName: 'light' | 'dark') => {
      const theme = themes[themeName]
      script.dataset.theme = theme
      document.querySelector<HTMLIFrameElement>('iframe.giscus-frame')?.contentWindow?.postMessage(
        {
          giscus: { setConfig: { theme } },
        },
        'https://giscus.app',
      )
    }
    window.addEventListener('site-theme-change', () => syncTheme(resolvedTheme()))
    const container = section.querySelector<HTMLElement>('.giscus')!
    container.addEventListener(
      'load',
      (event) => {
        if (event.target instanceof HTMLIFrameElement) syncTheme(resolvedTheme())
      },
      true,
    )
    container.append(script)
  })()
</script>

<style>
  .comments {
    margin-top: var(--space-8);
  }
  .comments :global(.giscus),
  .comments :global(.giscus-frame) {
    width: 100%;
  }
  .comments :global(.giscus-frame) {
    display: block;
    border: 0;
  }
  .comments-unavailable {
    font-size: var(--size-ui);
    color: var(--muted-color);
  }
</style>
