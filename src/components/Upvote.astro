---
interface Props {
  postId: string
}
const { postId } = Astro.props
---

<div class="upvote" data-upvote data-post-id={postId}>
  <button type="button" aria-label="点赞">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <polyline points="17 11 12 6 7 11" />
      <polyline points="17 18 12 13 7 18" />
    </svg>
    <span data-count aria-hidden="true">
      &nbsp;
    </span>
  </button>
  <span class="visually-hidden" aria-live="polite" data-announce></span>
  <noscript>启用 JavaScript 后可以点赞。</noscript>
</div>

<script>
  import { actions } from 'astro:actions'

  const root = document.querySelector<HTMLElement>('[data-upvote]')
  if (root) {
    const button = root.querySelector('button')!
    const count = root.querySelector<HTMLElement>('[data-count]')!
    const announce = root.querySelector<HTMLElement>('[data-announce]')!
    const postId = root.dataset.postId!
    let votedOnThisPage = false
    let loadedVotes: number | null = null

    function showCount(votes: number) {
      count.textContent = String(votes)
      button.setAttribute('aria-label', `${button.disabled ? '已点赞' : '点赞'}，${votes} 票`)
    }

    void actions
      .getVotes({ postId })
      .then(({ data, error }) => {
        // An in-flight read can predate a vote cast while it was running.
        if (error || votedOnThisPage) return
        if (data.voted) button.disabled = true
        loadedVotes = data.count
        showCount(data.count)
      })
      .catch(() => {})

    button.addEventListener('click', () => {
      if (button.disabled) return
      votedOnThisPage = true
      button.dataset.justVoted = ''
      // Like Bear Blog, feedback is immediate and independent of the submission result.
      void actions.upvote({ postId }).catch(() => {})
      button.disabled = true
      if (loadedVotes === null) button.setAttribute('aria-label', '已点赞')
      else showCount(loadedVotes + 1)
      announce.textContent = '已点赞'
    })
  }
</script>

<style>
  .upvote {
    margin-top: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--muted-color);
    font-size: 0.875rem;
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background-color: var(--code-block-background-color);
    color: inherit;
    font-variant-numeric: tabular-nums;
    touch-action: manipulation;
    flex-shrink: 0;
    transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-count] {
    line-height: 1;
  }
  [data-count]:empty {
    display: none;
  }
  svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  button:disabled {
    color: var(--link-color);
    border-color: color-mix(in srgb, var(--link-color) 35%, var(--border-color));
    background-color: color-mix(in srgb, var(--link-color) 6%, var(--code-block-background-color));
    cursor: default;
  }
  @media (hover: hover) {
    button:not(:disabled):hover {
      color: var(--link-color);
      border-color: color-mix(in srgb, var(--link-color) 35%, var(--border-color));
    }
  }
  @keyframes upvote-chevron {
    0% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-3.5px);
    }
    75% {
      transform: translateY(1px);
    }
    100% {
      transform: translateY(0);
    }
  }
  @keyframes upvote-count {
    from {
      opacity: 0.4;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    button:not(:disabled, :focus-visible):active {
      transform: scale(0.95);
    }
    button[data-just-voted] polyline:first-child {
      animation: upvote-chevron 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    button[data-just-voted] polyline:last-child {
      animation: upvote-chevron 420ms cubic-bezier(0.22, 1, 0.36, 1) 45ms;
    }
    button[data-just-voted] [data-count] {
      animation: upvote-count 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
  @media (scripting: none) {
    button {
      display: none;
    }
  }
</style>
