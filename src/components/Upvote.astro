---
interface Props {
  postId: string
}
const { postId } = Astro.props
---

<div class="upvote" data-upvote data-post-id={postId}>
  <button type="button" aria-label="点赞">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <polyline points="17 11 12 6 7 11" />
      <polyline points="17 18 12 13 7 18" />
    </svg>
    <span data-count aria-hidden="true">
      &nbsp;
    </span>
  </button>
  <span class="visually-hidden" aria-live="polite" data-announce></span>
  <noscript>启用 JavaScript 后可以点赞。</noscript>
</div>

<script>
  import { actions } from 'astro:actions'

  const root = document.querySelector<HTMLElement>('[data-upvote]')
  if (root) {
    const button = root.querySelector('button')!
    const count = root.querySelector<HTMLElement>('[data-count]')!
    const announce = root.querySelector<HTMLElement>('[data-announce]')!
    const postId = root.dataset.postId!

    function showCount(votes: number) {
      count.textContent = String(votes)
      button.setAttribute('aria-label', `${button.disabled ? '已点赞' : '点赞'}，${votes} 票`)
    }

    void actions
      .getVotes({ postId })
      .then(({ data, error }) => {
        if (error) return
        if (data.voted) button.disabled = true
        showCount(data.count)
      })
      .catch(() => {})

    button.addEventListener('click', () => {
      if (button.disabled) return
      // Like Bear Blog, feedback is immediate and independent of the submission result.
      void actions.upvote({ postId }).catch(() => {})
      button.disabled = true
      showCount(Number(count.textContent) + 1)
      announce.textContent = '已点赞'
    })
  }
</script>

<style>
  .upvote {
    margin-top: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--muted-color);
    font-size: 0.875rem;
  }
  button {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-variant-numeric: tabular-nums;
    touch-action: manipulation;
    flex-shrink: 0;
  }
  [data-count] {
    margin-top: -3px;
    line-height: 1.4;
  }
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  button:disabled {
    color: var(--link-color);
    cursor: default;
  }
  @media (hover: hover) {
    button:not(:disabled):hover {
      color: var(--link-color);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    button:not(:disabled, :focus-visible):active {
      transform: scale(0.96);
    }
  }
</style>
