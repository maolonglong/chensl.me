<template id="code-copy-template">
  <button class="code-copy" type="button" aria-label="复制代码">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <g data-copy-icon="idle">
        <rect x="8" y="8" width="12" height="12" rx="2" />
        <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
      </g>
      <g data-copy-icon="done">
        <path d="m5 12.5 4.5 4.5L19 7.5" />
      </g>
    </svg>
  </button>
</template>
<script>
  ;(() => {
    'use strict'
    const template = document.querySelector<HTMLTemplateElement>('#code-copy-template')
    if (!template || !navigator.clipboard) return
    const highlights = document.querySelectorAll('.prose .highlight')
    if (!highlights.length) return
    const status = document.createElement('span')
    status.className = 'visually-hidden code-copy-status'
    status.setAttribute('role', 'status')
    document.body.append(status)
    highlights.forEach((highlight) => {
      const code = highlight.querySelector('code')
      if (!code) return
      const block = document.createElement('div')
      block.className = 'code-block'
      highlight.before(block)
      const button = template.content.firstElementChild!.cloneNode(true) as HTMLButtonElement
      block.append(highlight, button)
      let reset: ReturnType<typeof setTimeout>
      button.addEventListener('click', async () => {
        let copied = true
        try {
          await navigator.clipboard.writeText(code.textContent.replace(/\n$/, ''))
        } catch {
          copied = false
        }
        clearTimeout(reset)
        button.dataset.state = copied ? 'done' : 'failed'
        status.textContent = copied ? '已复制' : '复制失败'
        reset = setTimeout(() => {
          delete button.dataset.state
          status.textContent = ''
        }, 2000)
      })
    })
  })()
</script>

<style>
  :global(.code-block) {
    position: relative;
  }
  .code-copy {
    position: absolute;
    top: 4px;
    right: 9px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--muted-color);
    background-color: var(--code-background-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    opacity: 0.75;
    touch-action: manipulation;
    transition: opacity 100ms ease-out;
  }
  .code-copy::before {
    content: '';
    position: absolute;
    inset: -6px;
  }
  .code-copy:focus-visible {
    border-radius: var(--radius);
  }
  .code-copy:focus-visible,
  .code-copy:active {
    opacity: 1;
  }
  :global(.code-block) :global(.line:first-child) {
    padding-right: 32px;
  }
  .code-copy [data-copy-icon='done'],
  .code-copy[data-state='done'] [data-copy-icon='idle'] {
    display: none;
  }
  .code-copy[data-state='done'] [data-copy-icon='done'] {
    display: inline;
  }
  @media (hover: hover) {
    .code-copy {
      opacity: 0;
    }
    :global(.code-block:hover) .code-copy,
    :global(.code-block:focus-within) .code-copy,
    .code-copy[data-state] {
      opacity: 0.75;
    }
    :global(.code-block) .code-copy:hover,
    :global(.code-block) .code-copy:focus-visible,
    :global(.code-block) .code-copy:active {
      color: var(--heading-color);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .code-copy {
      transition: none;
    }
  }
</style>
