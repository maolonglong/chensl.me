---
import '../styles/global.css'
// JinKai slices for text outside the build-time subsets, such as news read from D1.
// src/lib/fonts.mjs writes this file before Astro starts.
import '../../.astro/site-fonts/slices.css'
import Theme from '../components/Theme.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { Font } from 'astro:assets'
import { cardFor, cardHeight, cardPath, cardWidth, fixedCards } from '../lib/og.mjs'
import { newsFeedTitle, siteDescription, siteTitle } from '../lib/site.mjs'

export interface Props {
  title?: string
  description?: string
  pubDate?: Date
  updatedDate?: Date
  article?: boolean
  notFound?: boolean
}

const {
  title = siteTitle,
  description = siteDescription,
  pubDate,
  updatedDate,
  article = false,
  notFound = false,
} = Astro.props
const path = Astro.url.pathname
const isHome = path === '/'
const isNews = path === '/news' || path.startsWith('/news/')
const documentTitle = isHome ? siteTitle : `${title} | ${siteTitle}`
const metadataTitle = isHome ? siteTitle : title
const canonical = new URL(path, Astro.site!)
const card = cardFor(path, article)
const image = new URL(cardPath(card), Astro.site!)
const imageAlt = article ? title : fixedCards[card as keyof typeof fixedCards].title
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': isHome
    ? 'WebSite'
    : article
      ? 'BlogPosting'
      : path === '/blog/'
        ? 'CollectionPage'
        : 'WebPage',
  name: metadataTitle,
  url: canonical.href,
  description,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: 'Shaolong Chen' },
}
if (article)
  Object.assign(schema, {
    headline: title,
    image: image.href,
    ...(pubDate && { datePublished: pubDate.toISOString() }),
    ...(updatedDate && { dateModified: updatedDate.toISOString() }),
    mainEntityOfPage: canonical.href,
  })
const newsCurrent = path === '/news/' ? 'page' : path.startsWith('/news/') ? 'location' : undefined
const blogCurrent = path === '/blog/' ? 'page' : path.startsWith('/blog/') ? 'location' : undefined
const searchCurrent = path === '/search/' ? 'page' : undefined
const feed = isNews
  ? { href: '/news/index.xml', label: 'AI News RSS' }
  : { href: '/index.xml', label: 'RSS' }
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Theme />
    <title>{documentTitle}</title>
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta name="description" content={description} />
        <meta name="author" content="Shaolong Chen" />
        <meta property="og:site_name" content={siteTitle} />
        <meta property="og:locale" content="zh_CN" />
        <meta property="og:title" content={metadataTitle} />
        <meta property="og:type" content={article ? 'article' : 'website'} />
        <meta property="og:url" content={canonical} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(cardWidth)} />
        <meta property="og:image:height" content={String(cardHeight)} />
        <meta property="og:image:alt" content={imageAlt} />
        {article && pubDate && (
          <meta property="article:published_time" content={pubDate.toISOString()} />
        )}
        {article && updatedDate && (
          <meta property="article:modified_time" content={updatedDate.toISOString()} />
        )}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={metadataTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
        />
      </>
    )}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-jinkai" preload={false} />
    <Font cssVariable="--font-jetbrains" preload={false} />
    {
      // News pages advertise the news feed in place of the blog feed, in the head and the footer.
      isNews ? (
        <link
          rel="alternate"
          type="application/rss+xml"
          href={new URL('/news/index.xml', Astro.site!)}
          title={newsFeedTitle}
        />
      ) : (
        <link
          rel="alternate"
          type="application/rss+xml"
          href={new URL('/index.xml', Astro.site!)}
          title={siteTitle}
        />
      )
    }
    {article && <link rel="alternate" type="text/markdown" href={new URL('index.md', canonical)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <header class="site-header">
      <p class="site-title">
        <a href="/">{siteTitle}</a>
      </p>
      <nav aria-label="主导航">
        <a href="/blog/" aria-current={blogCurrent}>
          博客
        </a>
        <a href="/news/" aria-current={newsCurrent}>
          AI News
        </a>
        <a class="search-link" href="/search/" aria-label="搜索" aria-current={searchCurrent}>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-4-4" />
          </svg>
        </a>
        <ThemeToggle />
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href={feed.href} type="application/rss+xml" set:text={feed.label} /> / 基于{' '}
        <a href="https://astro.build">Astro</a> 构建 / 排版灵感来自{' '}
        <a href="https://github.com/tw93/Kami">Kami</a>
      </p>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100dvh;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 32px var(--gutter);
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: 0.02em;
    color: var(--text-color);
    background-color: var(--background-color);
    overflow-wrap: break-word;
  }
  main {
    flex: 1;
  }
  .skip-link {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1;
    padding: 8px 16px;
    color: var(--background-color);
    background: var(--link-color);
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 64px;
  }
  .site-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .site-title a {
    color: var(--heading-color);
    text-decoration-line: none;
  }
  /* The icons' targets reach halfway into the gap beside them (see .search-link::before and
     ThemeToggle), so the gap stays the text spacing and the targets never overlap. */
  .site-header nav {
    --nav-gap: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--nav-gap);
    font-size: 0.875rem;
  }
  .site-header nav a {
    white-space: nowrap;
  }
  .site-header nav a[aria-current] {
    text-decoration-line: underline;
    text-underline-offset: 0.25em;
  }
  /* The search icon matches ThemeToggle: a 24 px box in the heading color, with a target 44 px
     tall that does not grow the header row. It is 44 px wide where the 20 px gap leaves room and
     24 px plus the gap on phones, so it never overlaps the theme toggle's target. */
  .site-header nav .search-link {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 24px;
    height: 24px;
    color: var(--heading-color);
    touch-action: manipulation;
    transition: opacity 100ms ease-out;
  }
  .site-header nav .search-link::before {
    content: '';
    position: absolute;
    inset: -10px calc(var(--nav-gap) / -2);
  }
  /* An icon has no text to underline, so the current page draws the same line under the glyph. */
  .site-header nav .search-link[aria-current]::after {
    content: '';
    position: absolute;
    right: 4px;
    bottom: -0.25em;
    left: 4px;
    height: 0.08em;
    background: currentColor;
  }
  .site-header nav .search-link:active {
    opacity: 0.65;
  }
  .site-footer {
    margin-top: 72px;
    padding-top: 20px;
    font-size: 0.875rem;
    color: var(--muted-color);
    border-top: 1px solid var(--border-color);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer a {
    text-decoration-line: underline;
  }
  @media (max-width: 600px) {
    :global(body) {
      padding-block: 24px;
    }
    .site-header {
      margin-bottom: 48px;
    }
    .site-header nav {
      --nav-gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header nav .search-link {
      transition: none;
    }
  }
</style>
