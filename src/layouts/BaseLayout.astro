---
import '../styles/global.css'
// JinKai slices for text outside the build-time subsets, such as news read from D1.
// src/lib/fonts.mjs writes this file before Astro starts.
import '../../.astro/site-fonts/slices.css'
import Theme from '../components/Theme.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { Font } from 'astro:assets'
import { articleCard, cardHeight, cardPath, cardWidth, fixedCards } from '../lib/og.mjs'
import { newsFeedTitle, siteDescription, siteTitle } from '../lib/site.mjs'

export interface Props {
  title?: string
  description?: string
  pubDate?: Date
  updatedDate?: Date
  article?: boolean
  wordCount?: number
  notFound?: boolean
}

const {
  title = siteTitle,
  description = siteDescription,
  pubDate,
  updatedDate,
  article = false,
  wordCount,
  notFound = false,
} = Astro.props
const path = Astro.url.pathname
// The one place that reads the route. The nav state, share card, schema type, and feed derive
// from the page kind, so a new route family is one more branch here.
type PageKind =
  'home' | 'blog' | 'article' | 'news' | 'news-issue' | 'news-archive' | 'search' | 'page'
function pageKind(pathname: string): PageKind {
  if (pathname === '/') return 'home'
  if (pathname === '/blog/') return 'blog'
  if (pathname === '/news/') return 'news'
  if (pathname.startsWith('/news/archive/')) return 'news-archive'
  if (pathname.startsWith('/news/')) return 'news-issue'
  if (pathname === '/search/') return 'search'
  return 'page'
}
const kind: PageKind = article ? 'article' : pageKind(path)
const isHome = kind === 'home'
const isNews = kind === 'news' || kind === 'news-issue' || kind === 'news-archive'
const documentTitle = isHome ? siteTitle : `${title} | ${siteTitle}`
const metadataTitle = isHome ? siteTitle : title
const canonical = new URL(path, Astro.site!)
// An AI News issue shares the AI News card, so the Worker never renders an image. Pages without
// their own card, such as /search/, use the home card.
const kindCards: Partial<Record<PageKind, keyof typeof fixedCards>> = {
  home: 'home',
  blog: 'blog',
  news: 'news',
  'news-issue': 'news',
  'news-archive': 'news-archive',
}
const fixedCard = kindCards[kind] ?? 'home'
const card = article ? articleCard(path.replace(/^\/blog\/|\/$/g, '')) : fixedCard
const image = new URL(cardPath(card), Astro.site!)
const imageAlt = article ? title : fixedCards[fixedCard].title
const schemaTypes: Partial<Record<PageKind, string>> = {
  home: 'WebSite',
  article: 'BlogPosting',
  blog: 'CollectionPage',
}
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': schemaTypes[kind] ?? 'WebPage',
  name: metadataTitle,
  url: canonical.href,
  description,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: 'Shaolong Chen' },
}
if (article)
  Object.assign(schema, {
    headline: title,
    image: image.href,
    ...(pubDate && { datePublished: pubDate.toISOString() }),
    ...(updatedDate && { dateModified: updatedDate.toISOString() }),
    ...(wordCount !== undefined && { wordCount }),
    mainEntityOfPage: canonical.href,
  })
const blogCurrent = kind === 'blog' ? 'page' : kind === 'article' ? 'location' : undefined
const newsCurrent = kind === 'news' ? 'page' : isNews ? 'location' : undefined
const searchCurrent = kind === 'search' ? 'page' : undefined
const feed = isNews
  ? { href: '/news/index.xml', label: 'AI News RSS' }
  : { href: '/index.xml', label: 'RSS' }
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Theme />
    <title>{documentTitle}</title>
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta name="description" content={description} />
        <meta name="author" content="Shaolong Chen" />
        <meta property="og:site_name" content={siteTitle} />
        <meta property="og:locale" content="zh_CN" />
        <meta property="og:title" content={metadataTitle} />
        <meta property="og:type" content={article ? 'article' : 'website'} />
        <meta property="og:url" content={canonical} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(cardWidth)} />
        <meta property="og:image:height" content={String(cardHeight)} />
        <meta property="og:image:alt" content={imageAlt} />
        {article && pubDate && (
          <meta property="article:published_time" content={pubDate.toISOString()} />
        )}
        {article && updatedDate && (
          <meta property="article:modified_time" content={updatedDate.toISOString()} />
        )}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={metadataTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
        />
      </>
    )}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-source-serif" preload={false} />
    <Font cssVariable="--font-jinkai" preload={false} />
    <Font cssVariable="--font-jetbrains" preload={false} />
    {
      // News pages advertise the news feed in place of the blog feed, in the head and the footer.
      isNews ? (
        <link
          rel="alternate"
          type="application/rss+xml"
          href={new URL('/news/index.xml', Astro.site!)}
          title={newsFeedTitle}
        />
      ) : (
        <link
          rel="alternate"
          type="application/rss+xml"
          href={new URL('/index.xml', Astro.site!)}
          title={siteTitle}
        />
      )
    }
    {article && <link rel="alternate" type="text/markdown" href={new URL('index.md', canonical)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <header class="site-header">
      <p class="site-title">
        <a href="/">{siteTitle}</a>
      </p>
      <nav aria-label="主导航">
        <a class="nav-link" href="/blog/" aria-current={blogCurrent}>
          博客
        </a>
        <a class="nav-link" href="/news/" aria-current={newsCurrent}>
          AI News
        </a>
        <span class="nav-tools">
          <a class="icon-button" href="/search/" aria-label="搜索" aria-current={searchCurrent}>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg>
          </a>
          <ThemeToggle />
        </span>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-row">
        <p class="footer-mark">
          <a href="/">{siteTitle}</a>
          <span>{siteDescription}</span>
        </p>
        <p class="footer-links meta">
          <a href="/blog/">博客</a>
          <a href="/news/">AI News</a>
          <a href={feed.href} type="application/rss+xml" set:text={feed.label} />
          <a href="https://github.com/maolonglong">GitHub</a>
        </p>
      </div>
      <p class="footer-credit meta">
        基于 <a href="https://astro.build">Astro</a> 构建，排版灵感来自
        <a href="https://github.com/tw93/Kami">Kami</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header,
  main,
  .site-footer {
    box-sizing: border-box;
    width: 100%;
    max-width: calc(var(--shell) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  main {
    flex: 1;
  }
  .skip-link {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
    color: var(--background-color);
    background: var(--link-color);
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5);
    margin-bottom: var(--space-8);
  }
  .site-title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .site-title a {
    color: var(--heading-color);
    text-decoration-line: none;
  }
  .site-header nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--size-ui);
    letter-spacing: 0.01em;
  }
  /* The vertical padding makes a 40 px target without changing the visible spacing. */
  .nav-link {
    padding-block: 10px;
    color: var(--heading-color);
    white-space: nowrap;
  }
  .nav-link[aria-current] {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
  }
  @media (hover: hover) {
    .nav-link:hover {
      color: var(--heading-color);
      text-decoration-color: var(--rule-color);
    }
    .nav-link[aria-current]:hover {
      text-decoration-color: currentColor;
    }
  }
  .nav-tools {
    display: flex;
    gap: var(--space-1);
    margin-right: calc(-1 * var(--space-2));
  }
  /* Icon tools share a 40 px square; ThemeToggle uses the same class. */
  .site-header :global(.icon-button) {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    box-sizing: border-box;
    width: 40px;
    height: 40px;
    padding: 0;
    color: var(--heading-color);
    background: transparent;
    border: 0;
    border-radius: 999px;
    touch-action: manipulation;
    transition:
      background-color 150ms ease-out,
      transform 120ms var(--ease-out);
  }
  @media (hover: hover) {
    .site-header :global(.icon-button:hover) {
      background-color: var(--surface-color);
    }
  }
  .site-header :global(.icon-button:active) {
    background-color: var(--surface-color);
    transform: scale(0.92);
  }
  .site-header :global(.icon-button:focus-visible) {
    border-radius: 999px;
  }
  /* An icon has no text to underline, so the current page draws the same line under the glyph. */
  .icon-button[aria-current]::after {
    content: '';
    position: absolute;
    right: 12px;
    bottom: 6px;
    left: 12px;
    height: 1px;
    background: currentColor;
  }
  .site-footer {
    margin-top: var(--space-9);
    padding-block: var(--space-6) var(--space-7);
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-color);
  }
  .footer-mark {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    font-size: var(--size-ui);
    color: var(--muted-color);
  }
  .footer-mark a {
    font-size: var(--size-body);
    font-weight: 500;
    color: var(--heading-color);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
  }
  .footer-credit {
    margin: var(--space-4) 0 0;
    font-size: var(--size-caption);
  }
  @media (max-width: 600px) {
    .site-header {
      padding-block: var(--space-4);
      margin-bottom: var(--space-7);
    }
    .site-header nav {
      gap: var(--space-4);
    }
    .site-footer {
      margin-top: var(--space-8);
    }
  }
</style>
