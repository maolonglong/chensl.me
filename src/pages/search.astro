---
import BaseLayout from '../layouts/BaseLayout.astro'
import { maxQueryLength } from '../lib/search-fuse'

// Pagefind compiles its WebAssembly in the page. Only this page allows it.
Astro.csp?.insertScriptResource("'wasm-unsafe-eval'")
---

<BaseLayout title="搜索" description="搜索陈劭珑的技术文章和 AI News">
  <div class="measure">
    <h1 class="visually-hidden">搜索</h1>
    <form class="search-form" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="search-input">
        搜索文章和 AI News
      </label>
      <input
        id="search-input"
        class="search-input"
        type="search"
        name="q"
        maxlength={maxQueryLength}
        autocomplete="off"
        enterkeyhint="search"
        placeholder="搜索文章和 AI News"
      />
    </form>
    <p class="search-status meta" role="status" aria-live="polite"></p>
    <ol class="search-results entries"></ol>
    <noscript>
      <p class="search-status meta">搜索需要 JavaScript。</p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import {
    articleQuery,
    cleanQuery,
    fuse,
    maxQueryLength,
    type SearchHit,
  } from '../lib/search-fuse'

  interface ServerResults {
    news: SearchHit[]
  }
  interface PagefindResult {
    id: string
    data: () => Promise<{ url: string; excerpt: string; meta: Record<string, string> }>
  }
  interface Pagefind {
    search: (term: string) => Promise<{ results: PagefindResult[] }>
  }

  const form = document.querySelector<HTMLFormElement>('.search-form')!
  const input = document.querySelector<HTMLInputElement>('.search-input')!
  const status = document.querySelector<HTMLElement>('.search-status')!
  const list = document.querySelector<HTMLOListElement>('.search-results')!
  const typeLabels = { blog: '文章', news: 'AI News' }
  const resultLimit = 10

  // A path in a variable keeps the bundler from resolving the file, which exists only after
  // the build writes the Pagefind index.
  const pagefindPath = '/pagefind/pagefind.js'
  let pagefind: Promise<Pagefind> | undefined
  const loadPagefind = () =>
    (pagefind ??= import(/* @vite-ignore */ pagefindPath) as Promise<Pagefind>)

  const plainText = (html: string) =>
    new DOMParser().parseFromString(html, 'text/html').body.textContent ?? ''

  // Pagefind indexes each Han character as its own token, and articleQuery spaces Han runs and
  // quotes runs of two or more characters so 智能体 does not match articles that only contain its
  // characters apart; the plain search supplies the ranking, which phrase search lacks.
  async function articleHits(raw: string): Promise<SearchHit[]> {
    const { query, phrases } = articleQuery(raw)
    if (!query) return []
    const index = await loadPagefind()
    const [plain, ...phraseHits] = await Promise.all([
      index.search(query),
      ...phrases.map((phrase) => index.search(phrase)),
    ])
    let { results } = plain
    for (const phrase of phraseHits) {
      const phraseIds = new Set(phrase.results.map((result) => result.id))
      results = results.filter((result) => phraseIds.has(result.id))
    }
    const pages = await Promise.all(results.slice(0, resultLimit).map((result) => result.data()))
    return pages.map((page) => ({
      type: 'blog',
      url: page.url,
      title: (page.meta.title ?? page.url).replaceAll('\u200B', ''),
      date: page.meta.date ?? '',
      snippet: plainText(page.excerpt),
    }))
  }

  async function serverHits(query: string): Promise<ServerResults> {
    const response = await fetch(`/api/search/?q=${encodeURIComponent(query)}`)
    if (!response.ok) throw new Error(`/api/search/ answered ${response.status}`)
    return response.json()
  }

  function render(hits: SearchHit[]) {
    list.replaceChildren(
      ...hits.map((hit) => {
        const item = document.createElement('li')
        const title = document.createElement('p')
        title.className = 'entry-title'
        const link = document.createElement('a')
        link.href = hit.url
        link.textContent = hit.title
        title.append(link)
        const meta = document.createElement('p')
        meta.className = 'search-meta meta'
        meta.textContent = [typeLabels[hit.type], hit.date].filter(Boolean).join(' · ')
        item.append(title, meta)
        if (hit.snippet) {
          const snippet = document.createElement('p')
          snippet.className = 'search-snippet entry-summary'
          snippet.textContent = hit.snippet
          item.append(snippet)
        }
        return item
      }),
    )
  }

  let latest = 0
  async function run(query: string) {
    const id = ++latest
    if (!query) {
      list.replaceChildren()
      status.textContent = ''
      return
    }
    status.textContent = '正在搜索…'
    const [articles, server] = await Promise.allSettled([articleHits(query), serverHits(query)])
    // A slower answer to an earlier query must not replace the current results.
    if (id !== latest) return
    const lists: SearchHit[][] = []
    if (articles.status === 'fulfilled') lists.push(articles.value)
    if (server.status === 'fulfilled') lists.push(server.value.news)
    const hits = fuse(lists).slice(0, resultLimit * 2)
    render(hits)
    const degraded = articles.status === 'rejected' || server.status === 'rejected'
    status.textContent =
      (hits.length ? `找到 ${hits.length} 条结果` : '没有找到相关内容') +
      (degraded ? '（部分搜索暂时不可用）' : '')
  }

  function search(value: string) {
    const query = [...cleanQuery(value)].slice(0, maxQueryLength).join('')
    const url = new URL(location.href)
    if (query) url.searchParams.set('q', query)
    else url.searchParams.delete('q')
    history.replaceState(null, '', url)
    void run(query)
  }

  let timer: ReturnType<typeof setTimeout> | undefined
  const schedule = () => {
    clearTimeout(timer)
    timer = setTimeout(() => search(input.value), 300)
  }
  // An input method sends an input event for each pinyin keystroke (n, ni, ni hao) before the
  // reader picks the characters. Searching those would query the API and Pagefind for text the
  // reader never meant, so the search waits for compositionend. Browsers differ in whether an
  // input event follows compositionend; the debounce turns either order into one search.
  input.addEventListener('input', (event) => {
    if ((event as InputEvent).isComposing) clearTimeout(timer)
    else schedule()
  })
  input.addEventListener('compositionend', schedule)
  form.addEventListener('submit', (event) => {
    event.preventDefault()
    clearTimeout(timer)
    search(input.value)
  })
  input.addEventListener('focus', () => void loadPagefind(), { once: true })

  const initial = new URLSearchParams(location.search).get('q')
  if (initial) {
    input.value = initial
    search(initial)
  }
</script>

<style>
  /* A ruled line to write on, not a boxed field. */
  .search-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: var(--space-2) 0;
    font: inherit;
    font-size: var(--size-h3);
    letter-spacing: 0;
    color: var(--heading-color);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--rule-color);
    border-radius: 0;
    appearance: none;
    transition: border-color 150ms ease-out;
  }
  .search-input:focus {
    outline: none;
    border-bottom-color: var(--heading-color);
  }
  .search-input:focus-visible {
    outline: none;
    box-shadow: 0 1px 0 var(--heading-color);
  }
  .search-input::placeholder {
    color: var(--muted-color);
    opacity: 1;
  }
  .search-status {
    margin: var(--space-4) 0 0;
  }
  .search-status:empty {
    display: none;
  }
  .search-results {
    margin-top: var(--space-6);
  }
  .search-results :global(> li) {
    padding-block: var(--space-4);
  }
  .search-results :global(> li:first-child) {
    padding-top: 0;
  }
  .search-results :global(> li:last-child) {
    padding-bottom: 0;
  }
  .search-results :global(> li + li) {
    border-top: 1px solid var(--border-color);
  }
  .search-results :global(.search-meta) {
    margin: var(--space-1) 0 0;
  }
</style>
