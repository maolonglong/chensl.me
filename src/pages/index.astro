---
import BaseLayout from '../layouts/BaseLayout.astro'
import { displayDate, postUrl, publishedPosts } from '../lib/posts'
import { newsDescription } from '../lib/site.mjs'

const recentCount = 5
const posts = await publishedPosts()
const recent = posts.slice(0, recentCount)
---

<BaseLayout>
  <div class="home measure">
    <section class="hero">
      <h1 class="page-title">👋 Hi! 我是陈劭珑</h1>
      <!-- prettier-ignore -->
      <p class="lede">目前在 🌏 工作的软件工程师，为了 <span class="nowrap">🏠 🚗 💰</span> 而写代码。代码在 <a href="https://github.com/maolonglong" rel="me">GitHub</a>，偶尔在 <a href="https://x.com/chensl_" rel="me">Twitter</a> 说话。</p>
    </section>

    {recent.length > 0 && (
      <section class="home-section" aria-labelledby="home-posts">
        <div class="section-head">
          <h2 class="section-label" id="home-posts">
            最近的文章
          </h2>
          {posts.length > recentCount && (
            <a class="more arrow-link meta" href="/blog/">
              全部文章
            </a>
          )}
        </div>
        <ol class="entries">
          {recent.map((post) => (
            <li>
              <div class="entry-head">
                <h3 class="entry-title">
                  <a href={postUrl(post)}>{post.data.title}</a>
                </h3>
                <time class="meta" datetime={post.data.pubDate.toISOString()}>
                  {displayDate(post.data.pubDate)}
                </time>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="home-section" aria-labelledby="home-news">
      <div class="section-head">
        <h2 class="section-label" id="home-news">
          AI News
        </h2>
        <a class="more arrow-link meta" href="/news/">
          读最新一期
        </a>
      </div>
      <p class="news-teaser">{newsDescription}，由 bot 收集整理，作者不逐条审阅。</p>
    </section>
  </div>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    font-size: var(--size-body);
    line-height: 1.75;
    color: var(--text-color);
  }
  .nowrap {
    white-space: nowrap;
  }
  .lede a {
    color: var(--heading-color);
    text-decoration-line: underline;
    text-decoration-color: var(--rule-color);
  }
  @media (hover: hover) {
    .lede a:hover {
      color: var(--heading-color);
      text-decoration-color: currentColor;
    }
  }
  .home-section {
    margin-top: var(--space-8);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-top: var(--space-4);
  }
  .section-head .section-label {
    margin: 0;
    padding: 0;
  }
  .more {
    font-size: var(--size-caption);
    text-decoration-line: none;
  }
  .news-teaser {
    margin: 0;
    font-size: var(--size-ui);
    line-height: 1.65;
    color: var(--muted-color);
  }
  @media (max-width: 600px) {
    .home-section {
      margin-top: var(--space-7);
    }
  }
</style>
