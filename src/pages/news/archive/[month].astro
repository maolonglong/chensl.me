---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import NewsTags from '../../../components/NewsTags.astro'
import { isMonth, issueTags, newsCacheControl, newsUrl } from '../../../lib/news'
import { loadIssues } from '../../../lib/news-pages'

export const prerender = false

const { month } = Astro.params
const issues = isMonth(month) ? await loadIssues({ month }, Astro.response.headers) : []
Astro.response.headers.set('Cache-Control', issues.length ? newsCacheControl : 'no-store')
if (!issues.length) Astro.response.status = 404
---

{issues.length ? (
  <BaseLayout title={`AI News ${month}`} description={`AI News ${month} 的全部期数`}>
    <div class="measure">
      <header class="page-header">
        <p class="meta">
          <a href="/news/">AI News</a> · <a href="/news/archive/">归档</a>
        </p>
        <h1>{month}</h1>
      </header>
      <ol class="entries issues">
        {issues.map((issue) => (
          <li>
            <time class="meta" datetime={issue.date}>
              {issue.date}
            </time>
            <h2 class="entry-title">
              <a href={newsUrl(issue.date)}>{issue.title}</a>
            </h2>
            <NewsTags tags={issueTags(issue)} />
          </li>
        ))}
      </ol>
    </div>
  </BaseLayout>
) : (
  <BaseLayout title="没有这个月" notFound>
    <div class="measure">
      <h1>没有这个月</h1>
      <p>
        <a href="/news/archive/">返回归档</a>
      </p>
    </div>
  </BaseLayout>
)}

<style>
  .page-header {
    margin-bottom: var(--space-7);
  }
  .page-header > .meta {
    margin: 0 0 var(--space-3);
  }
  .issues time {
    display: block;
  }
</style>
