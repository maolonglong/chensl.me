---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { newsCacheControl } from '../../../lib/news'
import { loadMonths } from '../../../lib/news-pages'

export const prerender = false

const months = await loadMonths(Astro.response.headers)
Astro.response.headers.set('Cache-Control', newsCacheControl)
---

<BaseLayout title="AI News 归档" description="AI News 按月归档">
  <div class="measure">
    <header class="page-header">
      <p class="meta">
        <a href="/news/">AI News</a>
      </p>
      <h1>归档</h1>
    </header>
    {months.length ? (
      <ul class="months">
        {months.map(({ month, count }) => (
          <li>
            <a href={`/news/archive/${month}/`}>
              <time datetime={month}>{month}</time>
            </a>
            <span class="count meta">{count} 期</span>
          </li>
        ))}
      </ul>
    ) : (
      <p>还没有内容。</p>
    )}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
  }
  .page-header h1 {
    margin-bottom: 0;
    font-size: var(--size-h3);
    letter-spacing: 0;
  }
  .page-header > .meta {
    margin: 0 0 var(--space-2);
  }
  .months {
    margin: 0;
    padding: var(--space-4) 0 0;
    list-style: none;
    border-top: 1px solid var(--border-color);
  }
  .months li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }
  .months li:first-child {
    padding-top: 0;
  }
  .months li:last-child {
    padding-bottom: 0;
  }
  .months a {
    font-size: var(--size-list);
    font-weight: 400;
    color: var(--heading-color);
  }
  @media (hover: hover) {
    .months a:hover {
      color: var(--heading-color);
      text-decoration-color: var(--muted-color);
    }
  }
</style>
