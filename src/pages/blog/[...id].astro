---
import '../../styles/floating-controls.css'
import { render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BackToTop from '../../components/BackToTop.astro'
import FloatingToc from '../../components/FloatingToc.astro'
import Comments from '../../components/Comments.astro'
import CodeCopy from '../../components/CodeCopy.astro'
import Upvote from '../../components/Upvote.astro'
import { creationLabels, publishedPosts, displayDate, postUrl } from '../../lib/posts'
import { relatedPosts } from '../../lib/related'
import { isStaleSince } from '../../lib/stale'
import { readingLength } from '../../lib/reading-time.mjs'
export async function getStaticPaths() {
  const posts = await publishedPosts()
  const byId = new Map(posts.map((post) => [post.id, post]))
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, related: relatedPosts(post.id, byId) },
  }))
}
interface Props {
  post: CollectionEntry<'blog'>
  related: CollectionEntry<'blog'>[]
}
const { post, related } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const { wordCount, minutes } = remarkPluginFrontmatter.readingStats
const lastModified = post.data.updatedDate ?? post.data.pubDate
const { creation } = post.data
---

<BaseLayout {...post.data} updatedDate={lastModified} wordCount={wordCount} article>
  <article
    class="post"
    data-pagefind-body
    data-pagefind-meta={`date:${displayDate(post.data.pubDate)}`}
  >
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{displayDate(post.data.pubDate)}</time>{' '}
        <span aria-hidden="true">·</span>{' '}
        <span class="post-length">{readingLength(wordCount)}</span>{' '}
        <span aria-hidden="true">·</span> <span class="post-reading-time">{minutes} 分钟</span>
        {creation && (
          <>
            {' '}
            <span aria-hidden="true">·</span>{' '}
            <span class="post-creation">{creationLabels[creation.mode]}</span>
          </>
        )}
      </p>
      {creation?.note && <p class="post-creation-note">{creation.note}</p>}
      <p
        class="post-notice"
        data-stale-since={lastModified.toISOString()}
        hidden={!isStaleSince(lastModified)}
      >
        {post.data.updatedDate
          ? '这篇文章最后更新于两年多以前，部分内容可能已经过时。'
          : '这篇文章写于两年多以前，部分内容可能已经过时。'}
      </p>
    </header>
    <FloatingToc headings={headings} />
    <div class="prose">
      <Content />
    </div>
    {related.length > 0 && (
      <p class="post-related">
        <span>相关文章：</span>
        {related.map((other, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            <a href={postUrl(other)}>{other.data.title}</a>
          </>
        ))}
      </p>
    )}
    <CodeCopy />
  </article>
  <Upvote postId={post.id} />
  {post.data.comments && <Comments />}
  <BackToTop />
</BaseLayout>

<script>
  import { isStaleSince } from '../../lib/stale'

  for (const notice of document.querySelectorAll<HTMLElement>(
    '.post-notice[data-stale-since][hidden]',
  )) {
    if (isStaleSince(new Date(notice.dataset.staleSince!))) notice.removeAttribute('hidden')
  }
</script>

<style>
  .post-header {
    margin-bottom: 40px;
  }
  .post-meta,
  .post-creation-note,
  .post-notice {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted-color);
  }
  .post-meta {
    font-variant-numeric: tabular-nums;
  }
  .post-creation-note,
  .post-notice {
    margin-top: 8px;
  }
  .post-creation,
  .post-length,
  .post-reading-time {
    white-space: nowrap;
  }
  .post-creation-note {
    overflow-wrap: anywhere;
  }
  /* Flex drops the whitespace between the label, the links, and the separators. */
  .post-related {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0.5em;
    margin: 48px 0 0;
    font-size: 0.875rem;
    color: var(--muted-color);
  }
  .post-related a {
    text-decoration-line: underline;
  }
  /* Markdown descendants do not carry this component's scope attribute. */
  .prose :global(.astro-code),
  .prose :global(.astro-code span) {
    color: light-dark(var(--shiki-light), var(--shiki-dark));
    background-color: var(--code-block-background-color);
  }
  .prose :global(.astro-code) {
    -webkit-text-size-adjust: none;
  }
  .prose :global(.astro-code .line) {
    display: inline-block;
    min-height: 1em;
  }
</style>
