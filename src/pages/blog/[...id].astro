---
import { render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import FloatingToc from '../../components/FloatingToc.astro'
import Comments from '../../components/Comments.astro'
import CodeCopy from '../../components/CodeCopy.astro'
import Upvote from '../../components/Upvote.astro'
import { creationLabels, publishedPosts, displayDate } from '../../lib/posts'
import { isStaleSince } from '../../lib/stale'
export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { id: post.id }, props: { post } }))
}
interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
const { Content, headings } = await render(post)
const lastModified = post.data.updatedDate ?? post.data.pubDate
const { creation } = post.data
---

<BaseLayout {...post.data} updatedDate={lastModified} article>
  <article class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{displayDate(post.data.pubDate)}</time>
        {creation && (
          <>
            {' '}
            <span aria-hidden="true">·</span>{' '}
            <span class="post-creation">{creationLabels[creation.mode]}</span>
          </>
        )}
      </p>
      {creation?.note && <p class="post-creation-note">{creation.note}</p>}
      <p
        class="post-notice"
        data-stale-since={lastModified.toISOString()}
        hidden={!isStaleSince(lastModified)}
      >
        {post.data.updatedDate
          ? '这篇文章最后更新于两年多以前，部分内容可能已经过时。'
          : '这篇文章写于两年多以前，部分内容可能已经过时。'}
      </p>
    </header>
    <FloatingToc headings={headings} />
    <div class="prose">
      <Content />
    </div>
    <CodeCopy />
  </article>
  <Upvote postId={post.id} />
  {post.data.comments && <Comments />}
</BaseLayout>

<script>
  import { isStaleSince } from '../../lib/stale'

  for (const notice of document.querySelectorAll<HTMLElement>(
    '.post-notice[data-stale-since][hidden]',
  )) {
    if (isStaleSince(new Date(notice.dataset.staleSince!))) notice.removeAttribute('hidden')
  }
</script>

<style>
  .post-header {
    margin-bottom: 40px;
  }
  .post-meta,
  .post-creation-note,
  .post-notice {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted-color);
  }
  .post-meta {
    font-variant-numeric: tabular-nums;
  }
  .post-creation-note,
  .post-notice {
    margin-top: 8px;
  }
  .post-creation {
    white-space: nowrap;
  }
  .post-creation-note {
    overflow-wrap: anywhere;
  }
  /* Markdown descendants do not carry this component's scope attribute. */
  .prose :global(.astro-code),
  .prose :global(.astro-code span) {
    color: light-dark(var(--shiki-light), var(--shiki-dark));
    background-color: var(--code-background-color);
  }
  .prose :global(.astro-code) {
    -webkit-text-size-adjust: none;
  }
  .prose :global(.astro-code .line) {
    display: inline-block;
    min-height: 1em;
  }
</style>
