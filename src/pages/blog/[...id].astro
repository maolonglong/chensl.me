---
import { render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import FloatingToc from '../../components/FloatingToc.astro'
import Comments from '../../components/Comments.astro'
import CodeCopy from '../../components/CodeCopy.astro'
import Upvote from '../../components/Upvote.astro'
import { publishedPosts, displayDate } from '../../lib/posts'
export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { id: post.id }, props: { post } }))
}
interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
const { Content, headings } = await render(post)
---

<BaseLayout {...post.data} updatedDate={post.data.updatedDate ?? post.data.pubDate} article>
  <article class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{displayDate(post.data.pubDate)}</time>
      </p>
    </header>
    <FloatingToc headings={headings} />
    <div class="prose">
      <Content />
    </div>
    <CodeCopy />
  </article>
  <Upvote postId={post.id} />
  {post.data.comments && <Comments />}
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 40px;
  }
  .post-meta {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted-color);
    font-variant-numeric: tabular-nums;
  }
  /* Markdown descendants do not carry this component's scope attribute. */
  .prose :global(.astro-code),
  .prose :global(.astro-code span) {
    color: light-dark(var(--shiki-light), var(--shiki-dark));
    background-color: var(--code-background-color);
  }
  .prose :global(.astro-code) {
    -webkit-text-size-adjust: none;
  }
  .prose :global(.astro-code .line) {
    display: inline-block;
    min-height: 1em;
  }
</style>
