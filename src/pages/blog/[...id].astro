---
import '../../styles/floating-controls.css'
import { render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BackToTop from '../../components/BackToTop.astro'
import FloatingToc from '../../components/FloatingToc.astro'
import Comments from '../../components/Comments.astro'
import CodeCopy from '../../components/CodeCopy.astro'
import GitHubCards from '../../components/GitHubCards.astro'
import ImageZoom from '../../components/ImageZoom.astro'
import Upvote from '../../components/Upvote.astro'
import { creationLabels, publishedPosts, displayDate, postUrl } from '../../lib/posts'
import { isStaleSince } from '../../lib/stale'
import { readingLength } from '../../lib/reading-time.mjs'
export async function getStaticPaths() {
  const posts = await publishedPosts()
  // Posts are newest first, so the earlier article follows and the later one precedes.
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, earlier: posts[index + 1], later: posts[index - 1] },
  }))
}
interface Props {
  post: CollectionEntry<'blog'>
  earlier?: CollectionEntry<'blog'>
  later?: CollectionEntry<'blog'>
}
const { post, earlier, later } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const { wordCount, minutes } = remarkPluginFrontmatter.readingStats
const lastModified = post.data.updatedDate ?? post.data.pubDate
const { creation } = post.data
---

<BaseLayout {...post.data} updatedDate={lastModified} wordCount={wordCount} article>
  <article
    class="post measure"
    data-pagefind-body
    data-pagefind-meta={`date:${displayDate(post.data.pubDate)}`}
  >
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta meta">
        <time datetime={post.data.pubDate.toISOString()}>{displayDate(post.data.pubDate)}</time>{' '}
        <span aria-hidden="true">·</span>{' '}
        <span class="post-length">{readingLength(wordCount)}</span>{' '}
        <span aria-hidden="true">·</span> <span class="post-reading-time">{minutes} 分钟</span>
        {creation && (
          <>
            {' '}
            <span aria-hidden="true">·</span>{' '}
            <span class="post-creation">{creationLabels[creation.mode]}</span>
          </>
        )}
      </p>
      {creation?.note && <p class="post-creation-note meta">{creation.note}</p>}
      <p
        class="post-notice"
        data-stale-since={lastModified.toISOString()}
        hidden={!isStaleSince(lastModified)}
      >
        {post.data.updatedDate
          ? '这篇文章最后更新于两年多以前，部分内容可能已经过时。'
          : '这篇文章写于两年多以前，部分内容可能已经过时。'}
      </p>
    </header>
    <FloatingToc headings={headings} />
    <div class="prose">
      <Content />
    </div>
    <CodeCopy />
    {remarkPluginFrontmatter.githubCards && <GitHubCards />}
    {remarkPluginFrontmatter.images && <ImageZoom />}
  </article>
  <div class="post-end measure">
    <Upvote postId={post.id} />
    {(earlier || later) && (
      <nav class="post-nav" aria-label="相邻文章">
        {earlier && (
          <a class="post-nav-link" href={postUrl(earlier)} rel="prev">
            <span class="meta">上一篇</span>
            <span class="post-nav-title">{earlier.data.title}</span>
          </a>
        )}
        {later && (
          <a class="post-nav-link post-nav-later" href={postUrl(later)} rel="next">
            <span class="meta">下一篇</span>
            <span class="post-nav-title">{later.data.title}</span>
          </a>
        )}
      </nav>
    )}
    {post.data.comments && <Comments />}
  </div>
  <BackToTop />
</BaseLayout>

<script>
  import { isStaleSince } from '../../lib/stale'

  for (const notice of document.querySelectorAll<HTMLElement>(
    '.post-notice[data-stale-since][hidden]',
  )) {
    if (isStaleSince(new Date(notice.dataset.staleSince!))) notice.removeAttribute('hidden')
  }
</script>

<style>
  .post-header {
    margin-bottom: var(--space-7);
  }
  .post-header h1 {
    margin-bottom: var(--space-4);
  }
  .post-meta {
    margin: 0;
  }
  .post-meta > :not([aria-hidden]) {
    white-space: nowrap;
  }
  .post-creation-note {
    margin: var(--space-2) 0 0;
    overflow-wrap: anywhere;
  }
  .post-notice {
    margin: var(--space-5) 0 0;
    padding: var(--space-3) var(--space-4);
    font-size: var(--size-ui);
    line-height: 1.6;
    color: var(--text-color);
    background-color: var(--surface-color);
    border-radius: var(--radius);
  }
  .post-end {
    margin-top: var(--space-8);
  }
  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-color);
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--heading-color);
  }
  .post-nav-later {
    grid-column: 2;
    text-align: right;
  }
  .post-nav-title {
    font-weight: 500;
    line-height: 1.55;
    text-wrap: balance;
  }
  @media (hover: hover) {
    .post-nav-link:hover {
      color: var(--heading-color);
      text-decoration-line: none;
    }
    .post-nav-link:hover .post-nav-title {
      text-decoration-line: underline;
      text-decoration-color: var(--rule-color);
    }
  }
  .post-nav-link:active {
    opacity: 0.65;
  }
  @media (max-width: 600px) {
    .post-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-nav-later {
      grid-column: 1;
      text-align: left;
    }
  }
  /* Markdown descendants do not carry this component's scope attribute. */
  .prose :global(.astro-code),
  .prose :global(.astro-code span) {
    color: light-dark(var(--shiki-light), var(--shiki-dark));
    background-color: var(--surface-color);
  }
  .prose :global(.astro-code) {
    -webkit-text-size-adjust: none;
  }
  .prose :global(.astro-code .line) {
    display: inline-block;
    min-height: 1em;
  }
</style>
