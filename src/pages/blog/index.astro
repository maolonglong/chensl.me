---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { publishedPosts, displayDate, postUrl } from '../../lib/posts'
const posts = await publishedPosts()
const years = Map.groupBy(posts, (post) => displayDate(post.data.pubDate).slice(0, 4))
---

<BaseLayout title="博客" description="陈劭珑的技术文章：系统性能、Go/Zig/Rust 与 Agent 工程实践">
  <h1 class="visually-hidden">博客</h1>
  {[...years].map(([year, entries]) => (
    <>
      <h2 class="posts-year">{year}</h2>
      <ul class="blog-posts">
        {entries.map((post) => (
          <li>
            <a href={postUrl(post)}>
              <span>{post.data.title}</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {displayDate(post.data.pubDate).slice(5)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </>
  ))}
  {posts.length === 0 && <p class="blog-posts-empty">还没有文章</p>}
</BaseLayout>

<style>
  .posts-year {
    margin: 2.25em 0 0.35em;
    font-size: 1.125rem;
    color: var(--muted-color);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  :global(main) > .posts-year:first-of-type {
    margin-top: 0;
  }
  .blog-posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .blog-posts a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-block: 8px;
    transition:
      color 150ms ease-out,
      opacity 150ms ease-out;
  }
  .blog-posts span {
    min-width: 0;
  }
  .blog-posts a::after {
    content: '';
    flex: 1;
    min-width: 12px;
    border-bottom: 1px dashed var(--border-color);
    order: 1;
    translate: 0 0.22em;
    transition: border-color 150ms ease-out;
  }
  .blog-posts time {
    order: 2;
    font-size: 0.875rem;
    color: var(--muted-color);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .blog-posts a:visited {
    color: var(--visited-color);
  }
  @media (hover: hover) {
    .blog-posts:hover a:not(:hover) {
      opacity: 0.58;
    }
    .blog-posts a:hover {
      text-decoration-line: none;
    }
    .blog-posts a:hover span {
      text-decoration-line: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.22em;
    }
    .blog-posts a:hover::after {
      border-bottom-color: var(--muted-color);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-posts a,
    .blog-posts a::after {
      transition: none;
    }
  }
</style>
