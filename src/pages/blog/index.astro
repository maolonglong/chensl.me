---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { publishedPosts, displayDate, postUrl } from '../../lib/posts'
const posts = await publishedPosts()
const years = Map.groupBy(posts, (post) => displayDate(post.data.pubDate).slice(0, 4))
---

<BaseLayout title="博客" description="陈劭珑的技术博客文章归档">
  <div class="measure">
    <header class="page-header">
      <h1 class="page-title">博客</h1>
    </header>
    {[...years].map(([year, entries]) => (
      <section class="year-group" aria-labelledby={`year-${year}`}>
        <h2 class="posts-year" id={`year-${year}`}>
          {year}
        </h2>
        <ul class="entries blog-posts">
          {entries.map((post) => (
            <li>
              <div class="entry-head">
                <h3 class="entry-title">
                  <a href={postUrl(post)}>{post.data.title}</a>
                </h3>
                <time class="meta" datetime={post.data.pubDate.toISOString()}>
                  {displayDate(post.data.pubDate).slice(5)}
                </time>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {posts.length === 0 && <p class="blog-posts-empty">还没有文章</p>}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
  }
  /* The year hangs in its own column so the titles share one left edge. */
  .year-group {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: baseline;
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-color);
  }
  .year-group + .year-group {
    margin-top: var(--space-5);
  }
  .posts-year {
    margin: 0;
    font-size: var(--size-ui);
    font-weight: 400;
    color: var(--muted-color);
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 600px) {
    .year-group {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-3);
      padding-top: var(--space-4);
    }
    .year-group + .year-group {
      margin-top: var(--space-4);
    }
  }
</style>
