---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404" notFound>
  <div class="not-found measure">
    <p class="code meta">404</p>
    <h1 class="page-title">这个页面不存在。</h1>
    <p class="kaomoji" aria-hidden="true">
      ʕノ•ᴥ•ʔノ ︵ ┻━┻
    </p>
    <p class="links meta">
      <a class="arrow-link" href="/">
        返回首页
      </a>
      <a class="arrow-link" href="/blog/">
        看看博客
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  :global(main):has(> .not-found) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
  }
  .code {
    margin: 0 0 var(--space-2);
    letter-spacing: 0.08em;
  }
  /* A system monospace draws ┻━┻ as one table and costs no font download. */
  .kaomoji {
    margin: var(--space-5) 0 var(--space-7);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: var(--size-h2);
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--muted-color);
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    gap: var(--space-5);
    margin: 0;
  }
</style>
