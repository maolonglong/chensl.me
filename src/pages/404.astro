---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404" notFound>
  <div class="not-found">
    <h1>404</h1>
    <p class="kaomoji" aria-hidden="true">
      ʕノ•ᴥ•ʔノ ︵ ┻━┻
    </p>
    <p>
      这个页面不存在。
      <br />
      <a href="/">返回首页</a>
    </p>
  </div>
</BaseLayout>

<style>
  :global(main):has(> .not-found) {
    display: grid;
    align-content: center;
  }
  .not-found {
    text-align: center;
  }
  .not-found a {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }
  .kaomoji {
    margin: 0.5em 0 1em;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--heading-color);
  }
</style>
