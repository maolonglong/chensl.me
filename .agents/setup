#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

export CI=true
export MISE_VERSION="v2026.7.12"
export MISE_TRUSTED_CONFIG_PATHS="${repo_root}"

mise_bin="${HOME}/.local/bin/mise"
installed_mise_version="$("${mise_bin}" --version 2>/dev/null | awk '{ print $1 }' || true)"
if [ "${installed_mise_version}" != "${MISE_VERSION#v}" ]; then
  echo "Installing mise ${MISE_VERSION}..."
  curl -fsSL https://mise.run | MISE_VERSION="${MISE_VERSION}" sh
fi

echo "Installing pinned development tools..."
"${mise_bin}" trust --yes mise.toml
"${mise_bin}" install --locked
if [ "$("${mise_bin}" exec -- corepack --version 2>/dev/null || true)" != "0.34.0" ]; then
  "${mise_bin}" exec -- npm install --global corepack@0.34.0
fi
"${mise_bin}" exec -- corepack enable
"${mise_bin}" reshim

# Amp's non-interactive shells do not source .bashrc. Expose mise's dynamic
# shims through ~/.local/bin, which is already on the orb PATH.
shim_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/mise}/shims"
for command in node npm npx corepack pnpm hugo just shellcheck; do
  if [ -e "${shim_dir}/${command}" ]; then
    ln -sfn "${shim_dir}/${command}" "${HOME}/.local/bin/${command}"
  fi
done

echo "Installing Node.js dependencies..."
"${mise_bin}" exec -- pnpm install --frozen-lockfile
agent_browser_package_json="$("${mise_bin}" exec -- node -p "require.resolve('agent-browser/package.json')")"
agent_browser_package_dir="$(dirname "${agent_browser_package_json}")"
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64|Linux/amd64)
    agent_browser_bin="${agent_browser_package_dir}/bin/agent-browser-linux-x64"
    ;;
  Linux/aarch64|Linux/arm64)
    agent_browser_bin="${agent_browser_package_dir}/bin/agent-browser-linux-arm64"
    ;;
  Darwin/arm64)
    agent_browser_bin="${agent_browser_package_dir}/bin/agent-browser-darwin-arm64"
    ;;
  Darwin/x86_64)
    agent_browser_bin="${agent_browser_package_dir}/bin/agent-browser-darwin-x64"
    ;;
  *)
    echo "Unsupported agent-browser platform: $(uname -s)/$(uname -m)" >&2
    exit 1
    ;;
esac
ln -sfn "${agent_browser_bin}" "${HOME}/.local/bin/agent-browser"

echo "Installing agent-browser..."
agent_browser=("${mise_bin}" exec -- pnpm exec agent-browser)
if [ "$(uname -s)" = "Linux" ]; then
  agent_browser_version="$("${agent_browser[@]}" --version | awk '{ print $2 }')"
  browser_deps_marker="${HOME}/.cache/agent-browser/linux-deps-${agent_browser_version}"
  if [ ! -f "${browser_deps_marker}" ]; then
    "${agent_browser[@]}" install --with-deps
    mkdir -p "$(dirname "${browser_deps_marker}")"
    touch "${browser_deps_marker}"
  else
    "${agent_browser[@]}" install
  fi
else
  "${agent_browser[@]}" install
fi
"${agent_browser[@]}" doctor --offline --quick --json >/dev/null

echo "Building the site..."
"${mise_bin}" exec -- just build
