{
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "cf:types": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "astro build && playwright test",
    "lint": "oxlint --deny-warnings src scripts tests e2e astro.config.mjs playwright.config.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm cf:types && astro check && astro build && node --test tests/*.test.mjs && node scripts/check-site.mjs dist/client"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "astro": "7.3.5",
    "fontverter": "2.0.0",
    "harfbuzzjs": "1.6.1",
    "oxlint": "1.85.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "sharp": "^0.35.4",
    "subset-font": "2.9.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "wrangler": "^4.142.0"
  }
}
