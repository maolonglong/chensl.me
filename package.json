{
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src scripts astro.config.mjs",
    "check": "pnpm format:check && pnpm lint && astro check && astro build && node --test scripts/*.test.mjs && node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@types/node": "^26.6.3",
    "astro": "7.3.5",
    "oxlint": "1.85.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "wrangler": "^4.135.0"
  }
}
